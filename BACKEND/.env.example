APP_NAME="RAG Backend SMKN 26 Jakarta"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ==============================================================================
# DATABASE CONFIGURATION (SUPABASE OR LOCAL POSTGRESQL + PGVECTOR)
# ==============================================================================
# Opsi 1: Supabase (Free Tier Deployment - Recommended for Production)
# DB_CONNECTION=pgsql
# DB_HOST=db.xxxxxxxxxxxxxxxxxxxx.supabase.co
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=your-supabase-password
# DB_SSLMODE=require

# Opsi 2: Local PostgreSQL + pgvector (Laragon / Standalone Postgres)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rag_knowledge
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ==============================================================================
# RAG & AI INFRASTRUCTURE CONFIGURATION ($0 BUDGET STACK - PURE PHP)
# ==============================================================================
# LLM Provider: 'groq' (Llama 3.3 / Llama 3.1) atau 'gemini' (Gemini 1.5 Flash)
RAG_LLM_PROVIDER=gemini
RAG_LLM_MODEL=gemini-1.5-flash

# Embedding Provider: 'gemini' (Google text-embedding-004 / gemini-embedding-001)
RAG_EMBEDDING_PROVIDER=gemini
RAG_EMBEDDING_DIMENSIONS=384

# API Keys (Free Tier)
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key
HUGGINGFACE_API_KEY=your-huggingface-api-key

# RAG Thresholds
RAG_CONFIDENCE_MIN_SCORE=0.01
RAG_LOG_LEVEL=debug
